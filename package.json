{
  "name": "lectura-fiel",
  "private": true,
  "version": "0.3.12",
  "type": "module",
  "description": "Audiolibro fiel al original: simplificación léxica selectiva y glosario",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "data:export": "node scripts/export-pipeline-data.mjs",
    "wasm:pipeline": "npm run data:export && wasm-pack build crates/lectura-pipeline --target web --out-dir ../../src/wasm/pipeline",
    "desktop:legacy": "desktop\\run_dev.bat"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
